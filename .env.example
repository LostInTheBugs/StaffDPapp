# Staff Delegation — Environment Variables
# Copier ce fichier en .env et adapter

# Secret key for JWT signing — REQUIRED : generate with `openssl rand -hex 32`
# and paste it here. The server refuses to start with an example value or a
# key shorter than 32 characters (docker-compose fails fast if unset too).
SD_SECRET_KEY=

# Database URL (SQLite for dev, PostgreSQL for prod)
SD_DATABASE_URL=sqlite:///./data/staff_delegation.db

# Backend listen port (default: 8005)
SD_PORT=8005

# Token expiration in minutes (default: 1440 = 24h)
SD_ACCESS_TOKEN_EXPIRE_MINUTES=1440
